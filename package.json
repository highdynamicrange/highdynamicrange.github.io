{
  "name": "highdynamicrange-home",
  "version": "1.0.0",
  "description": "highdynamicrange 的个人主页，与 HDR Lab 相连接。",
  "repository": {
    "type": "git",
    "url": "https://github.com/highdynamicrange/highdynamicrange.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "contributors": [
    "Michael Rose",
    "Robert Zupko"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/academicpages/academicpages.github.io/issues"
  },
  "homepage": "https://highdynamicrange.github.io",
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "astro": "7.3.2",
    "fitvids": "^2.1.1",
    "jquery": "^3.7.1",
    "jquery-smooth-scroll": "^2.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "onchange": "^7.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^5.9.3",
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js node_modules/fitvids/dist/fitvids.min.js node_modules/jquery-smooth-scroll/jquery.smooth-scroll.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify",
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && npm run build && python3 scripts/check-links.py dist",
    "format": "prettier --write src scripts tests astro.config.mjs package.json tsconfig.json .github/workflows/pages.yml"
  },
  "private": true,
  "type": "module"
}

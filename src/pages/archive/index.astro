---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const entries=(await getCollection('archive')).sort((a,b)=>(b.data.date?.getTime()??0)-(a.data.date?.getTime()??0));
---
<Base title="早期笔记" active="/archive/"><header class="page-head"><p class="eyebrow">ARCHIVE / WHERE IT STARTED</p><h1>保留走过的路。</h1><p>早期的编程学习与项目笔记。新的 AI 实践和评测内容更新在 <a href="https://highdynamicrange.github.io/hdr-lab/notes/">HDR Lab</a>。</p></header><section class="section">{entries.map(entry=><a class="note-row" href={`/archive/${entry.id}/`}><span class="category">历史学习记录</span><div><h3>{entry.data.title}</h3><p>{entry.data.summary}</p></div>{entry.data.date?<time datetime={entry.data.date.toISOString()}>{entry.data.date.toISOString().slice(0,10).replaceAll('-','.')}</time>:<span class="muted" style="font-size:12px">日期未记录</span>}</a>)}</section></Base>
